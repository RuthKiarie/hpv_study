{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreateProcessingJob",
        "sagemaker:DescribeProcessingJob",
        "sagemaker:StopProcessingJob"
      ],
      "Resource": "arn:aws:sagemaker:us-east-1:041904915024:processing-job/hpv-feature-processing-*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::041904915024:role/sm-hpv-processing-role"
    },
    {
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:PutRule",
        "events:DescribeRule"
      ],
        "Resource": "arn:aws:events:us-east-1:041904915024:rule/StepFunctionsGetEventsFor*"
    }
  ]
}