{
  "Comment": "HPV screening risk pipeline - full: Glue, Processing, conditional Training, Model registration via SSM, Batch Transform",
  "StartAt": "RunGlueETLJob",
  "States": {
    "RunGlueETLJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "hpv-feature-etl",
        "Arguments": {
          "--RAW_PATH": "s3://rwk-hpv-mlops/raw/kenya_hpv_screening/dt=2026-09-19/kenya_hpv_screening_synthetic.csv",
          "--FEATURE_PATH": "s3://rwk-hpv-mlops/features/kenya_hpv_screening/",
          "--DT": "2026-09-19"
        }
      },
      "Retry": [{"ErrorEquals": ["Glue.AWSGlueException"], "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "RunSageMakerProcessing"
    },
    "RunSageMakerProcessing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createProcessingJob.sync",
      "Parameters": {
        "ProcessingJobName.$": "States.Format('hpv-feature-processing-{}', $$.Execution.Name)",
        "RoleArn": "arn:aws:iam::041904915024:role/sm-hpv-processing-role",
        "AppSpecification": {
          "ImageUri": "683313688378.dkr.ecr.us-east-1.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3",
          "ContainerEntrypoint": ["python3", "/opt/ml/processing/input/code/processing_script.py"]
        },
        "ProcessingResources": {"ClusterConfig": {"InstanceCount": 1, "InstanceType": "ml.m5.large", "VolumeSizeInGB": 5}},
        "StoppingCondition": {"MaxRuntimeInSeconds": 900},
        "ProcessingInputs": [
          {"InputName": "input-1", "S3Input": {"S3Uri": "s3://rwk-hpv-mlops/features/kenya_hpv_screening/", "LocalPath": "/opt/ml/processing/input", "S3DataType": "S3Prefix", "S3InputMode": "File", "S3DataDistributionType": "FullyReplicated"}},
          {"InputName": "code", "S3Input": {"S3Uri": "s3://rwk-hpv-mlops/processing-code/processing_script.py", "LocalPath": "/opt/ml/processing/input/code", "S3DataType": "S3Prefix", "S3InputMode": "File", "S3DataDistributionType": "FullyReplicated"}}
        ],
        "ProcessingOutputConfig": {"Outputs": [
          {"OutputName": "train", "S3Output": {"S3Uri": "s3://rwk-hpv-mlops/processing-output/train/", "LocalPath": "/opt/ml/processing/output/train", "S3UploadMode": "EndOfJob"}},
          {"OutputName": "test", "S3Output": {"S3Uri": "s3://rwk-hpv-mlops/processing-output/test/", "LocalPath": "/opt/ml/processing/output/test", "S3UploadMode": "EndOfJob"}},
          {"OutputName": "report", "S3Output": {"S3Uri": "s3://rwk-hpv-mlops/processing-output/report/", "LocalPath": "/opt/ml/processing/output/report", "S3UploadMode": "EndOfJob"}}
        ]}
      },
      "Retry": [{"ErrorEquals": ["SageMaker.AmazonSageMakerException"], "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "RetrainDue"
    },
    "RetrainDue": {
      "Type": "Choice",
      "Choices": [
        {"Variable": "$$.Execution.Input.retrain_requested", "BooleanEquals": true, "Next": "RunSageMakerTraining"}
      ],
      "Default": "GetCurrentModelParameter"
    },
    "RunSageMakerTraining": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
      "Parameters": {
        "TrainingJobName.$": "States.Format('hpv-risk-training-{}', $$.Execution.Name)",
        "RoleArn": "arn:aws:iam::041904915024:role/sm-hpv-training-role",
        "AlgorithmSpecification": {"TrainingImage": "683313688378.dkr.ecr.us-east-1.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3", "TrainingInputMode": "File"},
        "InputDataConfig": [
          {"ChannelName": "train", "DataSource": {"S3DataSource": {"S3DataType": "S3Prefix", "S3Uri": "s3://rwk-hpv-mlops/processing-output/train/", "S3DataDistributionType": "FullyReplicated"}}},
          {"ChannelName": "test", "DataSource": {"S3DataSource": {"S3DataType": "S3Prefix", "S3Uri": "s3://rwk-hpv-mlops/processing-output/test/", "S3DataDistributionType": "FullyReplicated"}}}
        ],
        "OutputDataConfig": {"S3OutputPath": "s3://rwk-hpv-mlops/training-output/"},
        "ResourceConfig": {"InstanceType": "ml.m5.large", "InstanceCount": 1, "VolumeSizeInGB": 5},
        "StoppingCondition": {"MaxRuntimeInSeconds": 900},
        "HyperParameters": {
          "sagemaker_program": "train.py",
          "sagemaker_submit_directory": "s3://rwk-hpv-mlops/training-code/stable/sourcedir.tar.gz"
        }
      },
      "Retry": [{"ErrorEquals": ["SageMaker.AmazonSageMakerException"], "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "SaveModelPathToRegistry"
    },
    "SaveModelPathToRegistry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:putParameter",
      "Parameters": {
        "Name": "/hpv-mlops/current-model-artifact",
        "Value.$": "$.ModelArtifacts.S3ModelArtifacts",
        "Type": "String",
        "Overwrite": true
      },
      "ResultPath": "$.PutParamResult",
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "NormalizeAfterTraining"
    },
    "NormalizeAfterTraining": {
      "Type": "Pass",
      "Parameters": {"ResolvedModelPath.$": "$.ModelArtifacts.S3ModelArtifacts"},
      "ResultPath": "$.Resolved",
      "Next": "CreateSageMakerModel"
    },
    "GetCurrentModelParameter": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getParameter",
      "Parameters": {"Name": "/hpv-mlops/current-model-artifact"},
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "NormalizeFromRegistry"
    },
    "NormalizeFromRegistry": {
      "Type": "Pass",
      "Parameters": {"ResolvedModelPath.$": "$.Parameter.Value"},
      "ResultPath": "$.Resolved",
      "Next": "CreateSageMakerModel"
    },
    "CreateSageMakerModel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createModel",
      "Parameters": {
        "ModelName.$": "States.Format('hpv-risk-model-{}', $$.Execution.Name)",
        "PrimaryContainer": {
          "Image": "683313688378.dkr.ecr.us-east-1.amazonaws.com/sagemaker-scikit-learn:1.2-1-cpu-py3",
          "ModelDataUrl.$": "$.Resolved.ResolvedModelPath",
          "Environment": {
            "SAGEMAKER_PROGRAM": "train.py",
            "SAGEMAKER_SUBMIT_DIRECTORY": "s3://rwk-hpv-mlops/training-code/stable/sourcedir.tar.gz"
          }
        },
        "ExecutionRoleArn": "arn:aws:iam::041904915024:role/sm-hpv-transform-role"
      },
      "ResultPath": "$.CreateModelResult",
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "RunBatchTransform"
    },
    "RunBatchTransform": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createTransformJob.sync",
      "Parameters": {
        "TransformJobName.$": "States.Format('hpv-risk-transform-{}', $$.Execution.Name)",
        "ModelName.$": "States.Format('hpv-risk-model-{}', $$.Execution.Name)",
        "TransformInput": {
          "DataSource": {"S3DataSource": {"S3DataType": "S3Prefix", "S3Uri": "s3://rwk-hpv-mlops/scoring-input/test_for_scoring.csv"}},
          "ContentType": "text/csv",
          "SplitType": "Line"
        },
        "TransformOutput": {"S3OutputPath": "s3://rwk-hpv-mlops/batch-transform-output/", "Accept": "text/csv", "AssembleWith": "Line"},
        "TransformResources": {"InstanceType": "ml.m5.large", "InstanceCount": 1},
        "DataProcessing": {"InputFilter": "$[1:]", "JoinSource": "Input"}
      },
      "ResultPath": "$.TransformResult",
      "Retry": [{"ErrorEquals": ["SageMaker.AmazonSageMakerException"], "IntervalSeconds": 30, "MaxAttempts": 2, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "Next": "WriteResultsToDynamoDB"
    },
    "WriteResultsToDynamoDB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "hpv-write-results",
        "Payload": {
          "bucket": "rwk-hpv-mlops",
          "key": "batch-transform-output/test_for_scoring.csv.out",
          "model_artifact_path.$": "$.Resolved.ResolvedModelPath"
        }
      },
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"], "IntervalSeconds": 15, "MaxAttempts": 2, "BackoffRate": 2.0}],
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "PipelineFailed"}],
      "End": true
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Cause": "Pipeline failed after retries"
    }
  }
}